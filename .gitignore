# Python virtual environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment variables & secrets
.env
.env.local
*.env

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Data directory
# Ignore all generated and large data files by default
data/raw/*
data/processed/*
data/sample/*

# Keep .gitkeep files in data subdirectories
!data/*/.gitkeep

# Explicitly keep Phase 1 baseline customer dataset
!data/raw/customers.csv

# Scratch / local working directory — not committed
scratch/

# Phase 2A downloaded raw datasets — large files, download_sources.py is source of truth
# (already covered by data/raw/* above; listed explicitly for clarity)
data/raw/facilities_master.csv
data/raw/bedutil_facility.csv
data/raw/hospital_beds.csv
